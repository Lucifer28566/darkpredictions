rules_version = '2';

// ============================================================
// DARK PREDICTIONS — Règles de sécurité Firebase Storage
// ============================================================
// À copier-coller dans Firebase Console → Storage → Rules.
//
// Principe :
//  - Tout le monde peut LIRE les fichiers publiés (images, vidéos,
//    mp3) car ils s'affichent sur le site public.
//  - Seul le compte "developer" peut UPLOADER ou SUPPRIMER des
//    fichiers (c'est lui l'admin qui publie le contenu).
//  - On limite la taille et le type de fichier pour éviter les
//    abus (quelqu'un qui essaierait d'uploader un exécutable, ou
//    une vidéo de plusieurs heures).
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // NOTE : Storage Rules ne peuvent pas faire de lecture Firestore
    // facilement comme les règles Firestore. On vérifie donc le rôle
    // via un "custom claim" nommé "role" sur le token d'authentification.
    // Ce claim est positionné automatiquement par la Cloud Function
    // `setUserRole` (voir functions/index.js) chaque fois qu'un rôle
    // change — donc il reste toujours à jour.
    function isDeveloper() {
      return isSignedIn() && request.auth.token.role == 'developer';
    }

    // ----------------------------------------------------------
    // Images et vidéos des PRÉDICTIONS
    // Vidéo : 10 minutes max → on ne peut pas vérifier une DURÉE
    // dans les règles Storage (elles ne lisent pas le contenu du
    // fichier), donc la limite de durée est appliquée côté
    // interface (le formulaire d'upload refuse une vidéo de plus
    // de 10 minutes avant même de l'envoyer). Ici, on limite la
    // TAILLE du fichier en sécurité supplémentaire (500 Mo max,
    // largement suffisant pour 10 min en bonne qualité).
    // ----------------------------------------------------------
    match /predictions/{predId}/{fileName} {
      allow read: if true;
      allow write: if isDeveloper()
                   && request.resource.size < 500 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
      allow delete: if isDeveloper();
    }

    // ----------------------------------------------------------
    // MP3 de la section Musique
    // ----------------------------------------------------------
    match /music/{trackId}/{fileName} {
      allow read: if true;
      allow write: if isDeveloper()
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
      allow delete: if isDeveloper();
    }

    // ----------------------------------------------------------
    // Couvertures / screenshots (apps, paintings, cover musique)
    // ----------------------------------------------------------
    match /covers/{fileName} {
      allow read: if true;
      allow write: if isDeveloper()
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isDeveloper();
    }

    // Par défaut : tout le reste interdit.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
