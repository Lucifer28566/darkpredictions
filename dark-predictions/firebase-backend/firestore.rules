rules_version = '2';

// ============================================================
// DARK PREDICTIONS — Règles de sécurité Firestore
// ============================================================
// À copier-coller dans Firebase Console → Firestore Database → Rules
// (ou à déployer avec `firebase deploy --only firestore:rules` si tu
// utilises la Firebase CLI — voir GUIDE-DEPLOIEMENT.md)
//
// Principe : par défaut tout est INTERDIT. On ouvre seulement ce qui
// est nécessaire, et on vérifie toujours le rôle réel stocké dans
// Firestore (jamais une valeur envoyée par le client).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------
    // Fonctions utilitaires
    // ----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isDeveloper() {
      return isSignedIn() && myRole() == 'developer';
    }

    function isPaidTier(role) {
      return role == 'basic' || role == 'gold' || role == 'vip';
    }

    function isVip() {
      return isSignedIn() && myRole() == 'vip';
    }

    // ----------------------------------------------------------
    // USERS
    // Chaque utilisateur peut lire son propre profil (pour savoir
    // son rôle / abonnement). Le developer peut lire tout le monde
    // (onglet Users de l'admin). Personne ne peut écrire son propre
    // rôle : seul le developer (humain, depuis l'admin) ou les
    // Cloud Functions (qui utilisent les droits admin, donc
    // ignorent ces règles) peuvent le faire.
    // ----------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isDeveloper());
      allow list: if isDeveloper();

      // Création de son propre profil à l'inscription : on autorise
      // la création initiale avec role == 'free' uniquement. Le tout
      // premier compte (rôle developer) est, lui, créé par une Cloud
      // Function avec des droits admin — donc ces règles ne s'y
      // appliquent pas.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'free';

      // Mise à jour : seul le developer peut changer un rôle.
      allow update: if isDeveloper();
      allow delete: if isDeveloper();
    }

    // ----------------------------------------------------------
    // PREDICTIONS — lecture publique des métadonnées (le contenu
    // sensible est filtré côté front selon le rôle, mais la vraie
    // protection doit être faite via Cloud Function si le contenu
    // est très sensible). Écriture réservée au developer.
    // ----------------------------------------------------------
    match /predictions/{predId} {
      allow read: if true;
      // Écriture admin, SAUF une exception : un utilisateur connecté peut
      // incrémenter uniquement thanksCount (bouton "Thank you").
      allow write: if isDeveloper()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thanksCount']));
    }

    // "Thank you" — un doc par (prediction, user) pour dédupliquer.
    match /thanks/{thanksId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && thanksId == request.resource.data.predId + '_' + request.auth.uid;
      allow update, delete: if isDeveloper();
    }

    // Liens sociaux + price list personnelle — publics en lecture, admin en écriture.
    match /socials/{itemId} {
      allow read: if true;
      allow write: if isDeveloper();
    }
    match /pricelist/{itemId} {
      allow read: if true;
      allow write: if isDeveloper();
    }

    // Engagement par membre (visites, points, dernière visite).
    // Chaque membre ne peut mettre à jour QUE son propre doc, et seulement
    // ces champs. Lecture réservée à l'admin (données privées).
    match /userStats/{uid} {
      allow read: if isDeveloper();
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','displayName','visits','points','lastSeenAt']);
      allow delete: if isDeveloper();
    }

    // ----------------------------------------------------------
    // MUSIC / APPS / PAINTINGS — lecture publique, écriture admin
    // ----------------------------------------------------------
    match /albums/{albumId} {
      allow read: if true;
      allow write: if isDeveloper();
    }
    match /music/{itemId} {
      allow read: if true;
      allow write: if isDeveloper();
    }
    match /apps/{itemId} {
      allow read: if true;
      allow write: if isDeveloper();
    }
    match /paintings/{itemId} {
      allow read: if true;
      allow write: if isDeveloper();
    }
    // Vidéos de prédictions réussies — lecture publique (preuve sociale
    // visible même par les non-membres, pour convertir), écriture admin.
    match /correctpredictions/{itemId} {
      allow read: if true;
      allow write: if isDeveloper();
    }

    // ----------------------------------------------------------
    // MESSAGES (VIP) — un VIP peut créer un message et lire SES
    // PROPRES messages uniquement. Le developer peut tout lire.
    // Personne ne peut modifier un message après l'envoi.
    // ----------------------------------------------------------
    match /messages/{msgId} {
      allow create: if isVip() && request.resource.data.fromUid == request.auth.uid;
      allow get: if isDeveloper() || (isSignedIn() && resource.data.fromUid == request.auth.uid);
      allow list: if isDeveloper();
      allow update: if false;
      allow delete: if isDeveloper();
    }

    // ----------------------------------------------------------
    // THE WALL — public comments/reviews/suggestions. Anyone (even
    // signed-out) can read. Paid-tier members (basic/gold/vip) AND the
    // developer account can create their own post. Only the developer
    // can edit or delete (moderation).
    // ----------------------------------------------------------
    match /wallPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && (isPaidTier(myRole()) || isDeveloper())
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isDeveloper();
    }

    // ----------------------------------------------------------
    // VIP CONVERSATIONS — un thread par VIP (doc id = userId).
    // Le VIP ne peut lire/écrire que SA conversation. Le developer
    // peut tout lire et répondre à n'importe quelle conversation.
    // ----------------------------------------------------------
    match /vipConversations/{userId} {
      allow get: if isDeveloper() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isDeveloper();
      allow create, update: if isDeveloper() ||
        (isVip() && request.auth.uid == userId);
      allow delete: if isDeveloper();
    }

    // ----------------------------------------------------------
    // STRIPE EVENTS LOG (utilisé par les Cloud Functions pour
    // éviter de traiter deux fois le même événement webhook).
    // Lecture/écriture réservées aux Cloud Functions (qui utilisent
    // les droits admin et ignorent ces règles) — donc on bloque
    // tout accès direct depuis le navigateur.
    // ----------------------------------------------------------
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // ----------------------------------------------------------
    // PAGE VIEWS / SESSIONS (statistiques) — n'importe quel
    // visiteur (même non connecté) peut créer un événement de
    // visite, mais ne peut RIEN lire ni modifier. Seul le developer
    // peut consulter les stats (lecture).
    // ----------------------------------------------------------
    match /pageViews/{viewId} {
      allow create: if true;
      allow read: if isDeveloper();
      allow update, delete: if false;
    }

    // Par défaut, tout le reste est interdit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
